# Copie este arquivo para ".env.local" (no seu computador) ou cadastre
# estas 3 variáveis na Vercel (Settings > Environment Variables).
# Onde encontrar: Supabase > Project Settings > API

# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# "anon public" (pode ficar visível no navegador; a segurança está nas regras do banco)
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
# "service_role" — SECRETA! Usada só no servidor para criar/editar usuários.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role
